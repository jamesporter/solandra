{
  "name": "solandra",
  "version": "0.24.0",
  "author": "James Porter <james@amimetic.co.uk>",
  "private": true,
  "description": "A framework for algorithmic art. TypeScript first. Make drawing concepts part of framework. Make APIs for humans.",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next dev --webpack",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:w": "vitest",
    "build:package": "node pre-publish && pnpm build:esm && pnpm build:cjs",
    "check:package": "pnpm build:package && node check-package.mjs",
    "build:source": "node extract-source.js",
    "build:esm": "tsc -p tsconfig-esm.json",
    "build:cjs": "tsc -p tsconfig-cjs.json",
    "build:samples": "tsx ./create-images.ts",
    "check:samples": "tsx ./check-images.ts",
    "build:book": "tsx ./build-book.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.4",
    "@types/mdx": "^2.0.14",
    "canvas": "^3.2.3",
    "classnames": "^2.5.1",
    "gray-matter": "^4.0.3",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-syntax-highlighter": "^16.1.1",
    "react-use": "^17.6.1",
    "rehype-pretty-code": "^0.14.5",
    "shiki": "^4.4.3",
    "solandra-svg": "^0.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "jszip": "^3.10.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jamesporter/solandra"
  },
  "bugs": {
    "url": "https://github.com/jamesporter/solandra/issues"
  },
  "pnpm": {
    "allowedBuildScripts": [
      "canvas",
      "esbuild",
      "unrs-resolver"
    ],
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "prismjs@<1.30.0": ">=1.30.0",
      "mdast-util-to-hast@>=13.0.0 <13.2.1": ">=13.2.1",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "minimatch@<3.1.4": ">=3.1.4",
      "brace-expansion@<1.1.13": ">=1.1.13",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "postcss@<8.5.10": ">=8.5.10",
      "js-cookie@<=3.0.5": ">=3.0.7",
      "vite@<=6.4.2": ">=6.4.3",
      "js-yaml@<3.15.0": ">=3.15.0"
    }
  },
  "packageManager": "pnpm@10.6.2+sha512.47870716bea1572b53df34ad8647b42962bc790ce2bf4562ba0f643237d7302a3d6a8ecef9e4bdfc01d23af1969aa90485d4cebb0b9638fa5ef1daef656f6c1b"
}
